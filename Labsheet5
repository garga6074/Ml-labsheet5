print("--- Steps 6 & 7: Initializing Q-Table and Hyperparameters ---")
# Initialize the Q-table with zeros: rows = states, columns = actions
state_size = env.observation_space.n
action_size = env.action_space.n
q_table = np.zeros((state_size, action_size))

# Hyperparameters
total_episodes = 2000        # 8. Train the agent for multiple episodes
learning_rate = 0.8          # Alpha (learning rate)
discount_rate = 0.95         # Gamma (discount factor)

# Exploration parameters (Epsilon-Greedy policy)
epsilon = 1.0                # Exploration rate
max_epsilon = 1.0
min_epsilon = 0.01
decay_rate = 0.005

print(f"Initialized empty Q-table of shape: {q_table.shape}\n")

# =====================================================================
# 8. Train the agent for multiple episodes using Q-Learning
# =====================================================================
print("--- Step 8: Training the Agent ---")

for episode in range(total_episodes):
    state, info = env.reset()
    done = False
    
    while not done:
        # Epsilon-greedy action selection strategy
        exp_exp_tradeoff = np.random.uniform(0, 1)
        
        if exp_exp_tradeoff > epsilon:
            # Exploitation: take the best known action
            action = np.argmax(q_table[state, :])
        else:
            # Exploration: take a random action
            action = env.action_space.sample()

        # Take action, observe new state and reward
        next_state, reward, terminated, truncated, info = env.step(action)
        done = terminated or truncated

        # Update Q-table using the Bellman Optimality Equation
        # Q(s,a) = Q(s,a) + lr * [R(s,a) + gamma * max Q(s',a') - Q(s,a)]
        q_table[state, action] = q_table[state, action] + learning_rate * (
            reward + discount_rate * np.max(q_table[next_state, :]) - q_table[state, action]
        )
        
        # Set current state to the new state
        state = next_state
        
    # Reduce epsilon to reduce exploration over time
    epsilon = min_epsilon + (max_epsilon - min_epsilon) * np.exp(-decay_rate * episode)

print(f"Training completed over {total_episodes} episodes.\n")

