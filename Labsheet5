# 10. Evaluate the trained Q-Learning agent
def evaluate_agent(env, Q, episodes=100):
    """
    Evaluates the performance of the trained Q-table over a set number of test episodes.
    """
    success_count = 0
    
    for _ in range(episodes):
        state, info = env.reset()
        done = False
        
        while not done:
            # Strictly exploit learned values during evaluation (epsilon = 0)
            action = np.argmax(Q[state])
            next_state, reward, terminated, truncated, info = env.step(action)
            done = terminated or truncated
            state = next_state
            
            if terminated and reward == 1.0:
                success_count += 1
                
    success_rate = (success_count / episodes) * 100
    print(f"Evaluation over {episodes} episodes -> Success Rate: {success_rate:.2f}%")
    return success_rate

