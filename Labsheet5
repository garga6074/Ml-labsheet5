# 15. Implement an epsilon-greedy action selection policy
def epsilon_greedy_policy(Q, state, epsilon, env):
    """
    Selects an action using the epsilon-greedy strategy.
    """
    if np.random.uniform(0, 1) < epsilon:
        return env.action_space.sample() # Explore
    else:
        # Exploit: choose the action with the max Q-value for the current state
        # Break ties randomly to ensure thorough exploration of equal paths
        return np.random.choice(np.where(Q[state] == np.max(Q[state]))[0])

def train_q_learning(env, episodes=2000, alpha=0.1, gamma=0.99, epsilon=1.0, max_epsilon=1.0, min_epsilon=0.01, decay_rate=0.001):
    """
    Trains a Q-learning agent and returns the Q-table and cumulative rewards list.
    """
    state_size = env.observation_space.n
    action_size = env.action_space.n
    
    # Initialize Q-table with zeros
    Q = np.zeros((state_size, action_size))
    
    rewards_per_episode = []
    
    for episode in range(episodes):
        state, info = env.reset()
        done = False
        total_rewards = 0
        
        while not done:
            # Choose action using epsilon-greedy policy
            action = epsilon_greedy_policy(Q, state, epsilon, env)
            
            # Take action, observe new state and reward
            next_state, reward, terminated, truncated, info = env.step(action)
            done = terminated or truncated
            
            # Update Q-table using the Bellman Equation
            Q[state, action] = Q[state, action] + alpha * (reward + gamma * np.max(Q[next_state]) - Q[state, action])
            
            state = next_state
            total_rewards += reward
            
        # Decay epsilon to shift from exploration to exploitation
        epsilon = min_epsilon + (max_epsilon - min_epsilon) * np.exp(-decay_rate * episode)
        rewards_per_episode.append(total_rewards)
        
    return Q, rewards_per_episode
    class CustomGridWorld:
    def __init__(self, size=4):
        self.size = size
        self.observation_space = gym.spaces.Discrete(size * size)
        self.action_space = gym.spaces.Discrete(4) # 0:Up, 1:Right, 2:Down, 3:Left
        self.goal = size * size - 1
        self.obstacles = [5, 7] # Trap states
        self.reset()
        
    def reset(self):
        self.agent_pos = 0
        return self.agent_pos, {}
        
    def step(self, action):
        x, y = divmod(self.agent_pos, self.size)
        if action == 0 and x > 0: x -= 1           # Up
        elif action == 1 and y < self.size - 1: y += 1 # Right
        elif action == 2 and x < self.size - 1: x += 1 # Down
        elif action == 3 and y > 0: y -= 1           # Left
        
        self.agent_pos = x * self.size + y
        
        if self.agent_pos == self.goal:
            return self.agent_pos, 10.0, True, False, {}
        elif self.agent_pos in self.obstacles:
            return self.agent_pos, -5.0, True, False, {}
        return self.agent_pos, -0.1, False, False, {}

